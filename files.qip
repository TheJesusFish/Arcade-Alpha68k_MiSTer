set_global_assignment -name VHDL_FILE rtl/mem/dual_port_ram.vhd
# save states: ddram, savestates, memory_stream, savestate_ui from MiSTer-devel/Arcade-TaitoF2_MiSTer @ 9438df98f1ea826c5398db43587992def0124603 (Martin Donlon, GPL-2.0)
